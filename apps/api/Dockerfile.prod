# syntax=docker/dockerfile:1
# Production image: multi-stage, prod-pruned workspace, amd64 target.
FROM node:22-alpine AS build

RUN npm install -g pnpm@9.15.0

WORKDIR /workspace

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/config/package.json packages/config/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY apps/api/package.json apps/api/package.json

RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY packages ./packages
COPY apps/api ./apps/api

RUN pnpm --filter @playwithpro/shared run build
RUN pnpm --filter @playwithpro/api exec prisma generate
RUN pnpm --filter @playwithpro/api run build

# Source maps for readable API stack traces (see apps/web/Dockerfile.prod).
ARG APP_RELEASE=unknown
RUN --mount=type=secret,id=posthog_cli_token \
    if [ -s /run/secrets/posthog_cli_token ]; then \
      export POSTHOG_CLI_TOKEN="$(cat /run/secrets/posthog_cli_token)" \
             POSTHOG_CLI_HOST=https://eu.posthog.com; \
      pnpm --filter @playwithpro/api exec posthog-cli sourcemap inject --directory apps/api/dist \
        && pnpm --filter @playwithpro/api exec posthog-cli sourcemap upload --directory apps/api/dist \
             --release-version "$APP_RELEASE" --project api; \
    else echo "posthog: no CLI token, skipping source-map upload"; fi
# prisma CLI stays available in prod deps for the migration Job
RUN pnpm prune --prod

FROM node:22-alpine AS prod

# ffmpeg/ffprobe: video validation and playback transcode (videos module)
RUN apk add --no-cache ffmpeg

ARG APP_RELEASE=unknown
ENV NODE_ENV=production \
    APP_RELEASE=$APP_RELEASE
LABEL org.opencontainers.image.revision=$APP_RELEASE

WORKDIR /workspace
COPY --from=build /workspace ./

WORKDIR /workspace/apps/api

EXPOSE 4000

CMD ["node", "dist/src/main"]
