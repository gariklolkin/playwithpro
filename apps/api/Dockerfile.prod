# syntax=docker/dockerfile:1
# Production image: multi-stage, prod-pruned workspace, amd64 target.
FROM node:22-alpine AS build

RUN npm install -g pnpm@9.15.0

WORKDIR /workspace

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/config/package.json packages/config/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY apps/api/package.json apps/api/package.json

RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY packages ./packages
COPY apps/api ./apps/api

RUN pnpm --filter @playwithpro/shared run build
RUN pnpm --filter @playwithpro/api exec prisma generate
RUN pnpm --filter @playwithpro/api run build
# prisma CLI stays available in prod deps for the migration Job
RUN pnpm prune --prod

FROM node:22-alpine AS prod

# ffmpeg/ffprobe: video validation and playback transcode (videos module)
RUN apk add --no-cache ffmpeg

ENV NODE_ENV=production

WORKDIR /workspace
COPY --from=build /workspace ./

WORKDIR /workspace/apps/api

EXPOSE 4000

CMD ["node", "dist/src/main"]
