# syntax=docker/dockerfile:1
# Production image: Next.js standalone output, amd64 target.
# NEXT_PUBLIC_* values are baked into the client bundle at build time.
FROM node:22-alpine AS build

RUN npm install -g pnpm@9.15.0

WORKDIR /workspace

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/config/package.json packages/config/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY apps/web/package.json apps/web/package.json

RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY packages ./packages
COPY apps/web ./apps/web

RUN pnpm --filter @playwithpro/shared run build

ARG NEXT_PUBLIC_API_URL=https://api.play-with.pro
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# Observability (all optional; empty = the SDK is never loaded).
# APP_RELEASE is the deploy SHA: stamped on every event/error as `release`
# and used to tag the uploaded source maps.
ARG APP_RELEASE=unknown
ARG NEXT_PUBLIC_POSTHOG_KEY=
ARG NEXT_PUBLIC_POSTHOG_REPLAY_SAMPLE=
# Feedback board URL (change 25); empty = no "Suggest an idea" links.
ARG NEXT_PUBLIC_FEEDBACK_URL=
ENV NEXT_PUBLIC_APP_RELEASE=$APP_RELEASE \
    NEXT_PUBLIC_POSTHOG_KEY=$NEXT_PUBLIC_POSTHOG_KEY \
    NEXT_PUBLIC_POSTHOG_REPLAY_SAMPLE=$NEXT_PUBLIC_POSTHOG_REPLAY_SAMPLE \
    NEXT_PUBLIC_FEEDBACK_URL=$NEXT_PUBLIC_FEEDBACK_URL

RUN pnpm --filter @playwithpro/web exec next build

# Source maps: inject release metadata into the bundles and upload the maps
# with a build secret that never lands in the image. Skipped when the secret
# is absent (local builds, forks) so the build stays reproducible.
RUN --mount=type=secret,id=posthog_cli_token \
    if [ -s /run/secrets/posthog_cli_token ] && [ -n "$NEXT_PUBLIC_POSTHOG_KEY" ]; then \
      export POSTHOG_CLI_TOKEN="$(cat /run/secrets/posthog_cli_token)" \
             POSTHOG_CLI_HOST=https://eu.posthog.com; \
      pnpm --filter @playwithpro/web exec posthog-cli sourcemap inject --directory .next \
        && pnpm --filter @playwithpro/web exec posthog-cli sourcemap upload --directory .next \
             --release-version "$APP_RELEASE" --project web; \
    else echo "posthog: no CLI token, skipping source-map upload"; fi

FROM node:22-alpine AS prod

ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

WORKDIR /app

# Standalone output mirrors the monorepo layout under its root.
COPY --from=build /workspace/apps/web/.next/standalone ./
COPY --from=build /workspace/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /workspace/apps/web/public ./apps/web/public
# Legal documents are read from disk at request time (change 30).
COPY --from=build /workspace/apps/web/content ./apps/web/content

EXPOSE 3000

CMD ["node", "apps/web/server.js"]
