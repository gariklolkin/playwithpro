# Production env contract for PlayWithPro (k8s Secret `playwithpro-env`).
# Copy to ~/.playwithpro-prod.env on the operator machine, fill in real values,
# then run infra/scripts/apply-secrets.sh. NEVER commit the filled file.

# --- Core ---
NODE_ENV=production
PORT=4000
WEB_APP_URL=https://play-with.pro
API_URL=https://api.play-with.pro

# --- Database (in-cluster PostgreSQL; password must match postgres secret) ---
POSTGRES_USER=playwithpro
POSTGRES_PASSWORD=<generate: openssl rand -hex 24>
POSTGRES_DB=playwithpro
DATABASE_URL=postgresql://playwithpro:<same password>@postgres:5432/playwithpro

# --- S3: Hetzner Object Storage ---
# Endpoint/bucket from the Hetzner console; the bucket needs a CORS rule
# allowing PUT/GET from https://play-with.pro (pre-signed browser uploads).
# Keep the bucket private: videos and avatars are both served through
# pre-signed URLs (avatars via the api's /avatars redirect).
S3_ENDPOINT=https://<location>.your-objectstorage.com
S3_PUBLIC_URL=https://<location>.your-objectstorage.com
S3_REGION=<location, e.g. fsn1>
S3_BUCKET=playwithpro-videos
S3_ACCESS_KEY=<from Hetzner console>
S3_SECRET_KEY=<from Hetzner console>

# --- SMTP (real provider: Brevo/Resend/Postmark/...) ---
SMTP_HOST=<provider smtp host>
SMTP_PORT=587
SMTP_USER=<provider login>
SMTP_PASSWORD=<provider password/key>
SMTP_FROM=PlayWithPro <no-reply@play-with.pro>

# --- Auth ---
JWT_ACCESS_SECRET=<generate: openssl rand -hex 32>
# Signs one-click unsubscribe links in optional emails (change 26).
NOTIFY_UNSUBSCRIBE_SECRET=<generate: openssl rand -hex 32>
# Provider send cap per UTC day (Brevo free plan: 300); warning at 80 %.
#EMAIL_DAILY_LIMIT=300
# Google OAuth client with redirect URI https://api.play-with.pro/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LiveKit (session rooms) ---
# Public signaling URL handed to browsers (TLS at Traefik, host meet.play-with.pro).
LIVEKIT_URL=wss://meet.play-with.pro
# Key/secret pair shared by the api (token minting, webhook verification) and
# the media server (apply-secrets.sh renders it into Secret livekit-config).
LIVEKIT_API_KEY=<generate: openssl rand -hex 8>
LIVEKIT_API_SECRET=<generate: openssl rand -hex 32>
# Used only by the rendered server config, not by the api.
LIVEKIT_NODE_IP=152.53.186.65
LIVEKIT_TURN_DOMAIN=meet.play-with.pro

# --- Cookies ---
# Parent domain so web SSR (play-with.pro) sees the access token set by the
# api (api.play-with.pro). Leave empty in dev.
AUTH_COOKIE_DOMAIN=play-with.pro

# --- Sessions & rooms (defaults; uncomment to override) ---
#AUTO_CONFIRM_WINDOW_HOURS=48
# Cancellation policy (snapshotted per session at booking): full refund until
# FREE hours before start, LATE_REFUND percent until NO_REFUND hours before,
# nothing after; GRACE minutes of free cancellation after a late booking.
#CANCELLATION_FREE_HOURS=24
#CANCELLATION_LATE_REFUND_PERCENT=50
#CANCELLATION_NO_REFUND_HOURS=2
#CANCELLATION_GRACE_MIN=30
# Late coach cancellations within 90 days that flag the coach for admins.
#COACH_LATE_CANCEL_THRESHOLD=3
# No-show protection: classify attendance N minutes after the join window
# closes; a coach has N hours to respond before the automatic refund;
# NO_SHOW_AUTO_RESOLVE=false is the kill switch (every case goes to an admin);
# a game without the coach's answer becomes an admin dispute after N days.
#NO_SHOW_CLASSIFY_BUFFER_MIN=5
#NO_SHOW_RESPONSE_WINDOW_HOURS=48
#NO_SHOW_AUTO_RESOLVE=true
#GAME_UNANSWERED_DISPUTE_DAYS=7
#ROOM_JOIN_WINDOW_BEFORE_MIN=15
#ROOM_JOIN_WINDOW_AFTER_MIN=30

# --- Video limits (defaults; uncomment to override) ---
# Per file, per video-analysis session (clip count + total minutes), per
# account library (GB + count), retention of unattached ready videos (days).
#VIDEO_MAX_SIZE_MB=2048
#VIDEO_MAX_DURATION_MIN=30
#SESSION_VIDEO_MAX_COUNT=5
#SESSION_VIDEO_MAX_TOTAL_MIN=60
#LIBRARY_MAX_TOTAL_GB=10
#LIBRARY_MAX_VIDEOS=20
#VIDEO_UNATTACHED_RETENTION_DAYS=90

# --- Verification-call scheduling (optional; empty = fake meeting provider) ---
GOOGLE_SA_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_IMPERSONATE_SUBJECT=

# --- Web (server-side) ---
# Internal API address for SSR fetches inside the cluster.
API_URL_INTERNAL=http://api:4000

# --- Observability: PostHog Cloud EU (all optional; empty = silent) ---
# One free-tier project = production. Leave every value empty and nothing is
# sent by either app (dev/CI behave the same way). See infra/k8s/README.md
# "Observability" for the project setup, and infra/posthog/ for the dashboard.
# Project API key (phc_…): the API's server events + the web server's flags.
POSTHOG_API_KEY=
# Same key, baked into the web bundle at BUILD time by build-push.sh (not a
# runtime Secret value for the browser — kept here so one file holds all keys).
NEXT_PUBLIC_POSTHOG_KEY=
# Ingestion host for server-side clients (EU region).
POSTHOG_HOST=https://eu.i.posthog.com
# Personal (phx_) or project-secret (phs_) key: local feature-flag evaluation.
POSTHOG_PERSONAL_API_KEY=
# Support "Secret API key" (Settings → Support): signs the HMAC identity for
# the in-app support panel; without it GET /support/identity is a 404.
POSTHOG_SUPPORT_SECRET=
# Share of consenting sessions recorded, 0..1 (build arg, default 0.5).
NEXT_PUBLIC_POSTHOG_REPLAY_SAMPLE=0.5
# APP_RELEASE is NOT set here: build-push.sh bakes the git SHA into both images.

# --- Feedback board: self-hosted Fider at feedback.play-with.pro (change 25) ---
# apply-secrets.sh renders Secret fider-env from these + the SMTP keys above
# (sender no-reply@play-with.pro, the app's verified Brevo identity). Both keys
# are required once the board manifests are deployed.
FIDER_JWT_SECRET=<generate: openssl rand -hex 32>
FIDER_DB_PASSWORD=<generate: openssl rand -hex 24>
# Board URL baked into the web bundle at BUILD time by build-push.sh; empty =
# no "Suggest an idea" links anywhere (the dev/CI default).
NEXT_PUBLIC_FEEDBACK_URL=https://feedback.play-with.pro
