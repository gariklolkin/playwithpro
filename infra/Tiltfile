
docker_compose("./docker-compose.yml")

dc_resource("postgres", labels=["infra"])
dc_resource("minio", labels=["infra"])
dc_resource("minio-bootstrap", labels=["infra"])
dc_resource("mailpit", labels=["infra"])

# Self-hosted Jitsi for session rooms: anonymous conferences + embedding,
# which no public instance provides anymore. Browser needs a one-time
# self-signed cert acceptance at https://localhost:8443.
dc_resource("jitsi-prosody", labels=["jitsi"])
dc_resource("jitsi-web", labels=["jitsi"], resource_deps=["jitsi-prosody"])
dc_resource("jitsi-jicofo", labels=["jitsi"], resource_deps=["jitsi-prosody"])
dc_resource("jitsi-jvb", labels=["jitsi"], resource_deps=["jitsi-prosody"])
dc_resource("jitsi-coturn", labels=["jitsi"])

dc_resource(
    "api",
    labels=["app"],
    resource_deps=["postgres"],
)

dc_resource(
    "web",
    labels=["app"],
    resource_deps=["api"],
)

docker_build(
    "playwithpro-api:dev",
    context="..",
    dockerfile="../apps/api/Dockerfile",
    live_update=[
        sync("../apps/api/src", "/workspace/apps/api/src"),
        sync("../apps/api/prisma", "/workspace/apps/api/prisma"),
        sync("../packages/shared/src", "/workspace/packages/shared/src"),
    ],
)

docker_build(
    "playwithpro-web:dev",
    context="..",
    dockerfile="../apps/web/Dockerfile",
    live_update=[
        sync("../apps/web/app", "/workspace/apps/web/app"),
        sync("../apps/web/public", "/workspace/apps/web/public"),
        sync("../packages/shared/src", "/workspace/packages/shared/src"),
    ],
)
